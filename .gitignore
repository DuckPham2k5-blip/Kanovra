# clerk configuration (can include secrets)
/.clerk/

# Task attachments written at runtime (see src/lib/storage.ts).
/uploads

# Per-machine assistant settings. `.claude/settings.json` is shared config and
# stays tracked; the `.local.` one is whatever this particular machine has
# agreed to allow, which is nobody else's business.
.claude/settings.local.json

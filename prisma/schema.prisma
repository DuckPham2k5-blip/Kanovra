// Kanovra — domain model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Workspace-level role. Ordered from most to least privileged; the RBAC helper
/// in src/lib/permissions.ts relies on this ordering.
enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Lifecycle state of a task, kept independent from the board column so that a
/// project can rename/reorder columns without losing reporting semantics.
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DELETED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  COMMENT_CREATED
  SUBTASK_CREATED
  CHECKLIST_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMPLETED
  COMMENT_MENTION
  COMMENT_CREATED
  INVITATION
  MEMBER_JOINED
  PROJECT_UPDATED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id         String    @id @default(cuid())
  /// Clerk user id — the source of truth for authentication.
  clerkId    String    @unique
  email      String    @unique
  name       String
  imageUrl   String?
  /// Last heartbeat from an open tab. Presence is derived from this rather than
  /// stored as a boolean: a browser that crashes or loses its connection never
  /// gets to say "I left", so a flag would stay stuck at online forever. A
  /// timestamp that simply stops being refreshed decays on its own.
  lastSeenAt DateTime?
  /// What this person has open right now, as an opaque scope string such as
  /// `map:<mapId>:<nodeId>`. Read only alongside `lastSeenAt`, so it decays for
  /// the same reason and needs no clearing when a tab closes.
  ///
  /// A column rather than process memory. PM2 runs two workers, and presence
  /// held in one of them is invisible to whoever is served by the other — the
  /// same reason live updates go through Postgres instead of an EventEmitter.
  focus      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ownedWorkspaces    Workspace[]          @relation("WorkspaceOwner")
  memberships        WorkspaceMember[]
  projectMembers     ProjectMember[]
  createdProjects    Project[]            @relation("ProjectCreator")
  createdTasks       Task[]               @relation("TaskCreator")
  assignedTasks      Task[]               @relation("TaskAssignee")
  comments           Comment[]
  activities         Activity[]           @relation("ActivityActor")
  notifications      Notification[]       @relation("NotificationRecipient")
  mindMaps           MindMap[]            @relation("MindMapAuthor")
  mindMapComments    MindMapComment[]     @relation("MindMapCommentAuthor")
  mindMapReads       MindMapCommentRead[]
  deletedTasks       DeletedTask[]
  actedNotifications Notification[]       @relation("NotificationActor")
  invitationsSent    Invitation[]         @relation("InvitationInviter")

  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  /// Tailwind-friendly hex accent used across the workspace UI.
  color       String   @default("#6366f1")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  projects      Project[]
  labels        Label[]
  activities    Activity[]
  notifications Notification[]
  invitations   Invitation[]
  mindMaps      MindMap[]
  deletedTasks  DeletedTask[]

  @@index([ownerId])
  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        Role             @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  name            String
  /// Short uppercase key used to build human task references, e.g. `WEB-42`.
  key             String
  description     String?
  color           String        @default("#6366f1")
  icon            String        @default("Rocket")
  status          ProjectStatus @default(ACTIVE)
  startDate       DateTime?
  dueDate         DateTime?
  archived        Boolean       @default(false)
  /// Name of a built-in gradient from `lib/project-banners.ts`, or null.
  bannerPreset    String?
  /// Id of an uploaded picture on disk, stored the way attachments are: outside
  /// the web root, served through a route that re-checks membership.
  bannerImageId   String?
  /// The picture's type, kept because the serving route sends `nosniff`: with
  /// sniffing off the browser will not guess, so an approximate content type
  /// means the image simply does not render.
  bannerImageMime String?
  /// A picture linked from elsewhere rather than uploaded. Fetched by each
  /// visitor's browser directly, so it is outside our membership check: the
  /// host on the other end sees who is looking, and can change or remove the
  /// picture whenever it likes. Only ever `https`.
  bannerImageUrl  String?
  /// Vertical framing of a picture, 0 (top) to 100 (bottom). A header strip is
  /// far wider than it is tall, so almost every picture is cropped top and
  /// bottom and the only interesting question is which band to keep.
  bannerPositionY Int           @default(50)
  /// Monotonic counter used to allocate the numeric part of a task reference.
  taskCounter     Int           @default(0)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  columns    BoardColumn[]
  tasks      Task[]
  activities Activity[]
  mindMaps   MindMap[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model BoardColumn {
  id        String     @id @default(cuid())
  projectId String
  name      String
  color     String     @default("#94a3b8")
  /// Fractional index so a column can be inserted between two others.
  order     Float
  /// WIP limit; 0 means "no limit".
  wipLimit  Int        @default(0)
  /// Tasks dropped into this column adopt this lifecycle status.
  status    TaskStatus @default(TODO)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, order])
  @@map("board_columns")
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(cuid())
  projectId   String
  columnId    String?
  /// Per-project sequence number; combined with Project.key gives `WEB-42`.
  number      Int
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(NONE)
  /// Fractional index within the column, ascending top to bottom.
  order       Float      @default(1000)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  /// Estimate in hours.
  estimate    Float?
  assigneeId  String?
  createdById String
  /// Non-null when this task is a subtask of another task.
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column         BoardColumn?     @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  parent         Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]           @relation("TaskSubtasks")
  labels         TaskLabel[]
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  activities     Activity[]
  /// What this task is waiting on.
  blockedBy      TaskDependency[] @relation("TaskBlocked")
  /// What is waiting on this task.
  blocks         TaskDependency[] @relation("TaskBlocking")

  @@unique([projectId, number])
  @@index([projectId, columnId, order])
  @@index([assigneeId])
  @@index([parentId])
  @@index([dueDate])
  @@index([status])
  @@map("tasks")
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

/// One task waiting on another.
///
/// A row reads in one direction only: `blockedTask` is waiting, `blockingTask`
/// is what it waits on. The two names are not "from" and "to" because a
/// dependency written backwards still saves and still draws, and says the
/// opposite of what somebody meant — see `lib/task-dependencies.ts`.
///
/// Both ends cascade. A deleted task cannot block anything and cannot be waiting
/// on anything, and an edge pointing at a row that is gone is not a fact worth
/// keeping. Undo restores the edges from the snapshot instead, so a delete that
/// is taken back does not quietly lose them.
///
/// The unique pair makes "add it twice" a no-op at the database rather than a
/// race between two people pressing the same button. The second index is for the
/// other direction: the *blocked* side is indexed by the unique pair already, and
/// asking "what is waiting on this?" has no index without it.
model TaskDependency {
  id             String   @id @default(cuid())
  blockedTaskId  String
  blockingTaskId String
  createdAt      DateTime @default(now())

  blockedTask  Task @relation("TaskBlocked", fields: [blockedTaskId], references: [id], onDelete: Cascade)
  blockingTask Task @relation("TaskBlocking", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([blockedTaskId, blockingTaskId])
  @@index([blockingTaskId])
  @@map("task_dependencies")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  order     Float
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
  @@map("checklist_items")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  /// Clerk-backed user ids extracted from `@mentions` at write time.
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  name      String
  url       String
  mimeType  String?
  size      Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Activity & notifications
// ---------------------------------------------------------------------------

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String?
  taskId      String?
  actorId     String
  type        ActivityType
  /// Human-readable summary rendered directly in the activity feed.
  message     String
  /// Structured payload (field diffs, column names, …) for richer rendering.
  metadata    Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("activities")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  /// Relative in-app link, e.g. `/w/acme/projects/xyz/board?task=abc`.
  link        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

/// The eight Thinking Maps. Each has its own structure, so the shape stored in
/// `data` depends on this — see `lib/mind-maps.ts`, which is the one place
/// that knows how to read and write each of them.
/// Six of the eight Thinking Maps. Bridge and double bubble were removed
/// outright — values, rows and code — rather than hidden, so nothing can create
/// one and nothing has to keep rendering one.
enum MindMapType {
  CIRCLE
  BUBBLE
  TREE
  MULTI_FLOW
  BRACE
}

model MindMap {
  id              String      @id @default(cuid())
  workspaceId     String
  /// Optional: a map can belong to one project, or sit loose in the workspace.
  projectId       String?
  type            MindMapType
  title           String
  /// The map's contents. Shape varies by `type`; validated on the way in by a
  /// zod schema per type rather than trusted because it is JSON.
  data            Json
  /// The map's own colour, 0-359. Null means the hue its type is born with, so
  /// a map nobody has recoloured draws exactly as it always did.
  hue             Int?
  /// The scenery the map is drawn on: the id of one of the drawn backgrounds, or
  /// an https link to a picture. Null is the plain backdrop built from the hue.
  ///
  /// Two columns rather than one JSON blob, because they are read on every
  /// render of the page and a blob would have to be parsed and validated to
  /// answer "which one". `backgroundKind` says how to read the other.
  backgroundKind  String?
  backgroundValue String?
  /// How saturated and how light that hue runs: vivid, soft, deep or mono.
  ///
  /// A string and not an enum on purpose. Tones are a design vocabulary and will
  /// be added to and dropped; removing a Prisma enum value means rebuilding the
  /// type and casting every row across, which fails while any row still holds
  /// the old value. A string that no longer matches falls back to vivid at the
  /// point it is read, which costs nothing and loses nothing.
  tone            String?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User                 @relation("MindMapAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  comments  MindMapComment[]
  reads     MindMapCommentRead[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("mind_maps")
}

/// A comment on one node of a mind map.
///
/// A row of its own rather than another field inside `MindMap.data`, and that is
/// the whole design decision here. A map is saved explicitly, all of it at once,
/// as a document somebody is drafting — so a comment living inside that blob
/// would be overwritten the next time anybody saved their own version of the
/// drawing. Discussion is not part of the document; it is about the document,
/// and it posts on its own the moment it is written.
///
/// `nodeId` points into the JSON by the node's client-generated id, which is
/// never rewritten once assigned. There is no foreign key to enforce — the node
/// is not a row — so comments whose node has been deleted are cleaned up when
/// the map is next saved.
model MindMapComment {
  id       String @id @default(cuid())
  mapId    String
  /// The `id` of a node inside `MindMap.data`, not a row anywhere.
  nodeId   String
  authorId String
  body     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  map    MindMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  author User    @relation("MindMapCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([mapId])
  @@index([mapId, nodeId])
  @@map("mind_map_comments")
}

/// How far one person has read the discussion on one node of one map.
///
/// A row per reader per node, not a flag on the comment: "read" is a fact about
/// a person, and two people looking at the same thread have different answers.
/// A timestamp rather than a boolean for the same reason the map's own comments
/// are timestamped — a new reply after you last looked has to be able to make an
/// already-read node unread again, which a boolean cannot express without being
/// reset by whoever writes the reply.
///
/// `nodeId` points into `MindMap.data` by the node's client-generated id, with no
/// foreign key to enforce, exactly as `MindMapComment` does. A row whose node has
/// gone is harmless: nothing looks it up, and it disappears with the map.
model MindMapCommentRead {
  id     String   @id @default(cuid())
  userId String
  mapId  String
  /// The `id` of a node inside `MindMap.data`, not a row anywhere.
  nodeId String
  /// When this person last opened that node's thread.
  readAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  MindMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  /// One row per person per node. The upsert on open depends on it.
  @@unique([userId, mapId, nodeId])
  @@index([mapId, userId])
  @@map("mind_map_comment_reads")
}

/// A task tree, kept just long enough to put it back.
///
/// Deleting a task cascades to its subtasks, labels, checklist items, comments
/// and attachments, so undoing it means recreating all of them. Two ways were
/// weighed. A `deletedAt` column would be more faithful — nothing is removed, so
/// nothing has to be rebuilt — but every read of a task would have to exclude
/// it, and there are about forty such reads once `_count.tasks` and nested
/// `subtasks` includes are counted. A Prisma client extension reaches the
/// top-level ones and not those, so the hole it leaves is a project's task count
/// quietly including deleted rows. A wrong number in a chart is the failure this
/// codebase keeps being bitten by, so the read path is left alone entirely and
/// the rows are stashed here instead.
///
/// The payload is written by the server and read back by the server; the client
/// only ever holds the row's id. That is deliberate: a snapshot round-tripped
/// through the browser would let a crafted payload restore a comment under
/// somebody else's name.
///
/// Attachment *files* are not touched by a task delete — only their rows are —
/// so a restored attachment finds its bytes still on disk.
model DeletedTask {
  id          String @id @default(cuid())
  workspaceId String
  /// Where it came from. Restoring into a project that has since gone is refused.
  projectId   String
  /// Who deleted it. Only they are offered the undo.
  actorId     String
  /// A short label for the toast, so the client needs nothing from the payload.
  summary     String
  /// The task and its descendants, with their labels, checklist items, comments
  /// and attachments. Activities are deliberately absent: a log is not undone.
  payload     Json

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  /// Swept by age on the next delete in the same workspace.
  @@index([workspaceId, createdAt])
  @@map("deleted_tasks")
}

// Kanovra — domain model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Workspace-level role. Ordered from most to least privileged; the RBAC helper
/// in src/lib/permissions.ts relies on this ordering.
enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Lifecycle state of a task, kept independent from the board column so that a
/// project can rename/reorder columns without losing reporting semantics.
enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DELETED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  COMMENT_CREATED
  SUBTASK_CREATED
  CHECKLIST_UPDATED
  PROJECT_CREATED
  PROJECT_UPDATED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMPLETED
  COMMENT_MENTION
  COMMENT_CREATED
  INVITATION
  MEMBER_JOINED
  PROJECT_UPDATED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  /// Clerk user id — the source of truth for authentication.
  clerkId   String   @unique
  email     String   @unique
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedWorkspaces    Workspace[]       @relation("WorkspaceOwner")
  memberships        WorkspaceMember[]
  projectMembers     ProjectMember[]
  createdProjects    Project[]         @relation("ProjectCreator")
  createdTasks       Task[]            @relation("TaskCreator")
  assignedTasks      Task[]            @relation("TaskAssignee")
  comments           Comment[]
  activities         Activity[]        @relation("ActivityActor")
  notifications      Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[]    @relation("NotificationActor")
  invitationsSent    Invitation[]      @relation("InvitationInviter")

  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  /// Tailwind-friendly hex accent used across the workspace UI.
  color       String   @default("#6366f1")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  projects      Project[]
  labels        Label[]
  activities    Activity[]
  notifications Notification[]
  invitations   Invitation[]

  @@index([ownerId])
  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        Role             @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  /// Short uppercase key used to build human task references, e.g. `WEB-42`.
  key         String
  description String?
  color       String        @default("#6366f1")
  icon        String        @default("Rocket")
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  dueDate     DateTime?
  archived    Boolean       @default(false)
  /// Monotonic counter used to allocate the numeric part of a task reference.
  taskCounter Int           @default(0)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  columns    BoardColumn[]
  tasks      Task[]
  activities Activity[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(MEMBER)
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model BoardColumn {
  id        String     @id @default(cuid())
  projectId String
  name      String
  color     String     @default("#94a3b8")
  /// Fractional index so a column can be inserted between two others.
  order     Float
  /// WIP limit; 0 means "no limit".
  wipLimit  Int        @default(0)
  /// Tasks dropped into this column adopt this lifecycle status.
  status    TaskStatus @default(TODO)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, order])
  @@map("board_columns")
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------

model Task {
  id          String     @id @default(cuid())
  projectId   String
  columnId    String?
  /// Per-project sequence number; combined with Project.key gives `WEB-42`.
  number      Int
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(NONE)
  /// Fractional index within the column, ascending top to bottom.
  order       Float      @default(1000)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  /// Estimate in hours.
  estimate    Float?
  assigneeId  String?
  createdById String
  /// Non-null when this task is a subtask of another task.
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column         BoardColumn?    @relation(fields: [columnId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  parent         Task?           @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]          @relation("TaskSubtasks")
  labels         TaskLabel[]
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  activities     Activity[]

  @@unique([projectId, number])
  @@index([projectId, columnId, order])
  @@index([assigneeId])
  @@index([parentId])
  @@index([dueDate])
  @@index([status])
  @@map("tasks")
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  order     Float
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
  @@map("checklist_items")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  /// Clerk-backed user ids extracted from `@mentions` at write time.
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  taskId    String
  name      String
  url       String
  mimeType  String?
  size      Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Activity & notifications
// ---------------------------------------------------------------------------

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String?
  taskId      String?
  actorId     String
  type        ActivityType
  /// Human-readable summary rendered directly in the activity feed.
  message     String
  /// Structured payload (field diffs, column names, …) for richer rendering.
  metadata    Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("activities")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  actorId     String?
  type        NotificationType
  title       String
  body        String?
  /// Relative in-app link, e.g. `/w/acme/projects/xyz/board?task=abc`.
  link        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

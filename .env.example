# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local docker:  docker compose up -d
DATABASE_URL="postgresql://taskforge:taskforge@localhost:5432/taskforge?schema=public"
# Only needed when DATABASE_URL points at a connection pooler (Neon/Supabase
# pgBouncer). Prisma Migrate uses DIRECT_URL. Otherwise set it to the same value.
DIRECT_URL="postgresql://taskforge:taskforge@localhost:5432/taskforge?schema=public"

# ---------------------------------------------------------------------------
# Clerk authentication — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# Signing secret from the Clerk dashboard → Webhooks → your endpoint.
# Endpoint URL: https://your-domain.com/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/onboarding"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# ---------------------------------------------------------------------------
# Email (Resend) — https://resend.com
# ---------------------------------------------------------------------------
# Optional. Without it, invite emails are skipped and the app falls back to
# the copyable invite link — nothing breaks, you just have to share it by hand.
RESEND_API_KEY=""
# Must be a verified sender on your Resend account. The default below only
# works for accounts still on Resend's sandbox domain.
RESEND_FROM_EMAIL="Kanovra <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# AI assistant (Anthropic) — https://console.anthropic.com
# ---------------------------------------------------------------------------
# Optional. Without it, the AI buttons still render but report that the
# assistant is not set up — no other feature is affected.
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Error monitoring
# ---------------------------------------------------------------------------
# Optional. Errors are always written to stdout as one JSON line each, which
# `docker logs` and `pm2 logs` can grep on their own. Set this to also push
# them to a Slack or Discord incoming webhook - anything that accepts a JSON
# POST works. Reporting is fire-and-forget and never delays a request.
ERROR_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------
# Where uploaded task attachments are written. Kept outside the web root on
# purpose - downloads go through /api/attachments/<id>, which checks workspace
# membership first. Point this at a mounted volume in production so files
# survive a redeploy.
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: comma-separated emails seeded as demo teammates by `npm run db:seed`.
SEED_DEMO_EMAILS=""
